#compdef gh_source

_arguments -s -S -C \
  '1:GitHub repository as owner/repo with an optional source path:' \
  '*--source[Source another relative file]:source file:_files' \
  '*--path[Append a relative directory to PATH]:directory:_files -/' \
  '*--fpath[Prepend a relative directory to fpath]:directory:_files -/' \
  '--preserve-zsh-options[Restore Zsh options after sourcing]' \
  '*--skip-build-if-present[Skip build when a project file or command exists]:value:' \
  '--build[Run the remaining argv as the build command]:command:_command_names' \
  '--loaded[Check successful activation]:repository or source:' \
  '--list[List successfully loaded sources]' \
  '--update[Update clean loaded repositories]' \
  '--help[Print help]' \
  '*::build argument:_normal'
